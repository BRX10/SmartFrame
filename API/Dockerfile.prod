# syntax=docker/dockerfile:1
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y python3-pip python3-dev libmagickwand-dev

# AUTH, HOST_SERVER, PORT_SERVER passes via docker-compose environment (runtime, not build args)

ENV TZ=Europe/Paris

RUN mkdir API
ADD . /API
WORKDIR /API
RUN pip3 install --break-system-packages -r requirements.txt

COPY . .

CMD python3 ./run.py
