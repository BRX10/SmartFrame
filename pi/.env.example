# SmartFrame Music Listener — Configuration
# Copiez ce fichier en .env et renseignez les valeurs

SMARTFRAME_API_URL=https://smartframe.knowhere.click
SMARTFRAME_API_TOKEN=eyJ...votre_token_JWT
SMARTFRAME_FRAME_ID=60f...votre_frame_id
CHROMECAST_NAME=Nest Mini salon

# Optionnel
POLL_INTERVAL=5
IDLE_TIMEOUT=120
LOG_LEVEL=INFO
